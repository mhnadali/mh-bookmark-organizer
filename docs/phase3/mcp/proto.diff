diff -ruN '--exclude=__pycache__' '--exclude=.ruff_cache' pkg_fixed/mhbm/mcp/cli.py pkg_proto/mhbm/mcp/cli.py
--- pkg_fixed/mhbm/mcp/cli.py	1970-01-01 00:00:00.000000000 +0000
