+def write_text_atomic(path: Path, text: str) -> None:
+    """The same temp-file-and-rename write for callers that already have the text (``install-chrome``)."""
+    path = Path(path)
+    tmp = path.with_name(path.name + ".mhbm-tmp")
+    with open(tmp, "w", encoding="utf-8") as fh:
+        fh.write(text)
+        fh.flush()
+        os.fsync(fh.fileno())
+    shutil.copymode(path, tmp)
+    tmp.replace(path)
