+def browser_running(profile_file: Path) -> bool:
+    """True if a Chromium-family browser is running on the profile that owns ``profile_file``.
+
+    Linux/macOS: the user-data-dir holds a ``SingletonLock`` symlink to ``<host>-<pid>``; it survives a crash, so the pid is
+    checked. Windows: the browser keeps ``lockfile`` open, so it cannot be opened for writing. Verified on Chromium 141
+    (tests/realbrowser); when in doubt (unreadable, other host) it answers False and the ``--confirm-chrome-closed`` flag remains."""
+    profile_file = Path(profile_file).resolve()
+    for root in (profile_file.parent, profile_file.parent.parent):
+        if platform.system() == "Windows":
+            lock = root / "lockfile"
+            if lock.exists():
+                try:
+                    with open(lock, "r+b"):
+                        pass
+                except PermissionError:
+                    return True
+            continue
+        lock = root / "SingletonLock"
+        if lock.is_symlink():
+            match = re.search(r"-(\d+)$", os.readlink(lock))
+            if match and _pid_alive(int(match.group(1))):
